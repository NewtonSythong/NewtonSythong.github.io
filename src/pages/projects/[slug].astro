---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	// Held-back projects don't get a public route at all — filtered here,
	// at path-generation time, rather than merely un-linked, so the page
	// genuinely doesn't exist for them (a direct URL guess 404s).
	const projects = await getCollection("projects", ({ data }) => data.status === "featured");
	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.name} — Newton Sythong`} description={project.data.description}>
	<article>
		<a class="back" href="/#projects">Back to Projects</a>
		<h1>{project.data.name}</h1>
		{
			project.data.image && (
				<img
					class="hero"
					src={project.data.image.src}
					alt={project.data.image.alt}
					decoding="async"
				/>
			)
		}
		<p>{project.data.description}</p>
		<p class="contribution"><strong>My contribution:</strong> {project.data.contribution}</p>
		{
			project.data.tags.length > 0 && (
				<ul class="tags">
					{project.data.tags.map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)
		}
		{
			project.data.liveDemoUrl && (
				<p>
					<a href={project.data.liveDemoUrl} target="_blank" rel="noopener noreferrer">
						Live demo
					</a>
				</p>
			)
		}
		<Content />
		{
			project.data.gallery.length > 0 && (
				<section class="gallery" aria-labelledby="gallery-heading">
					<h2 id="gallery-heading">More screenshots</h2>
					<ul>
						{project.data.gallery.map((shot) => (
							<li>
								<img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</Layout>

<style>
	/* Article width, the h1 treatment and the `.tags` pills are shared from
	   src/styles/global.css. */

	/* The arrow slides back on hover — the same gesture as the forward arrow
	   on the Projects cards, pointed the other way. */
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-decoration: none;
	}

	.back::before {
		content: "←";
		transition: transform 0.25s var(--ease);
	}

	.back:hover::before,
	.back:focus-visible::before {
		transform: translateX(-3px);
	}

	/* Unlike the card thumbnails this one carries real information — it is
	   the reader's first look at the project — so it keeps its alt text and
	   is not cropped to a fixed ratio. */
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin: 0 0 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.contribution {
		font-size: 0.92rem;
	}

	.contribution strong {
		color: var(--color-text);
	}

	.tags {
		margin: 1.25rem 0;
	}

	/* Screenshots vary in aspect ratio — some are full-window captures, others
	   are trimmed to a wide strip — so they are shown at their natural shape
	   rather than cropped to a common ratio. Cropping is right on the cards,
	   where a ragged grid would look careless; here the whole point is to see
	   the thing properly. */
	.gallery {
		margin-top: 2.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.gallery h2 {
		margin: 0 0 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.gallery ul {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.gallery img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}
</style>
