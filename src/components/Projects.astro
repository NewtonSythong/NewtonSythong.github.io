---
import { getCollection } from "astro:content";

// Fixture/placeholder entries live in src/content/projects/ at this stage
// (ticket 10 replaces them with real content). `status: "held-back"`
// entries are filtered out here rather than at the schema level, so they
// stay valid content that simply isn't ready to feature yet.
const allProjects = await getCollection("projects");
const featured = allProjects.filter((project) => project.data.status === "featured");
---

<section id="projects" aria-labelledby="projects-heading">
	<h2 id="projects-heading">Projects</h2>
	<ul class="project-list">
		{
			featured.map((project) => (
				<li class="card">
					{project.data.image && (
						<a class="thumb" href={`/projects/${project.data.slug}`} tabindex="-1" aria-hidden="true">
							<img
								src={project.data.image.src}
								alt=""
								width={project.data.image.width}
								height={project.data.image.height}
								loading="lazy"
								decoding="async"
							/>
						</a>
					)}
					<h3>
						<a href={`/projects/${project.data.slug}`}>{project.data.name}</a>
					</h3>
					<p>{project.data.description}</p>
					<p class="contribution">
						<strong>My contribution:</strong> {project.data.contribution}
					</p>
					{project.data.tags.length > 0 && (
						<ul class="tags">
							{project.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}
					{project.data.liveDemoUrl && (
						<a
							class="demo-link"
							href={project.data.liveDemoUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Live demo
						</a>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Section furniture, the `.card` surface and its hover lift, and the
	   `.tags` pills all come from src/styles/global.css. */
	.project-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 0;
	}

	/* Cards with imagery run the picture edge to edge: negating the card's
	   own padding is what makes the thumbnail read as part of the card
	   rather than as a framed picture sitting inside it. */
	.card {
		padding-top: 0;
		overflow: hidden;
	}

	/* The card's heading link already names the project, so the thumbnail is
	   redundant to a screen reader — hidden from the accessibility tree and
	   taken out of the tab order rather than given a duplicate label. */
	.thumb {
		display: block;
		margin: 0 -1.5rem 1.1rem;
	}

	.thumb img {
		display: block;
		width: 100%;
		/* `height: auto` is load-bearing, not tidiness. The <img> carries
		   `height` as an attribute so the space is reserved before the file
		   arrives, and that attribute is a presentational hint: it gives the
		   box a definite height, which makes the browser ignore
		   `aspect-ratio` entirely and stretch a 1600x592 screenshot into a
		   1600x592-tall crop. Overriding the hint hands the height back to
		   the ratio below. */
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-bottom: 1px solid var(--color-border);
	}

	/* A card without a thumbnail has no image to supply its top inset, so it
	   restores the padding the rule above removed. */
	.card:not(:has(.thumb)) {
		padding-top: 1.35rem;
	}

	h3 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
		line-height: 1.4;
	}

	h3 a {
		color: inherit;
		text-decoration: none;
		transition: color 0.25s var(--ease);
	}

	h3 a:hover,
	h3 a:focus-visible {
		color: var(--color-accent);
	}

	p {
		margin: 0 0 0.7rem;
	}

	.contribution {
		font-size: 0.88rem;
	}

	.contribution strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.tags {
		margin-top: 0.9rem;
	}

	/* The live-demo link is the one outbound call to action on a card, so it
	   gets an arrow that leans out on hover rather than a plain underline. */
	.demo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-decoration: none;
	}

	.demo-link::after {
		content: "→";
		transition: transform 0.25s var(--ease);
	}

	.demo-link:hover::after,
	.demo-link:focus-visible::after {
		transform: translateX(3px);
	}
</style>
