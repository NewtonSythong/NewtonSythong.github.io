---
import { getCollection } from "astro:content";

// Fixture/placeholder entries live in src/content/experience/ at this
// stage (ticket 10 replaces them with real content) — nothing here is
// hardcoded per-entry, so adding a new valid entry to the collection is
// enough for it to appear below with no code changes.
const entries = await getCollection("experience");
const sorted = [...entries].sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
---

<section id="experience" aria-labelledby="experience-heading">
	<h2 id="experience-heading">Experience</h2>
	<ol>
		{
			sorted.map((entry) => (
				<li class="card">
					<h3>
						{entry.data.title} · {entry.data.organization}
					</h3>
					<p class="dates">
						{entry.data.startDate}
						{entry.data.endDate ? ` – ${entry.data.endDate}` : " – Present"}
					</p>
					<p>{entry.data.description}</p>
					{entry.data.tags.length > 0 && (
						<ul class="tags">
							{entry.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ol>
</section>

<style>
	/* Section furniture, the `.card` surface and the `.tags` pills are all
	   defined once in src/styles/global.css. What is left here is the list
	   layout and the entry's own typography. */
	ol {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 0;
		padding: 0;
	}

	h3 {
		margin: 0 0 0.15rem;
		font-size: 1.02rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.dates {
		margin: 0 0 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	.card p:not(.dates) {
		margin: 0 0 0.9rem;
	}
</style>
