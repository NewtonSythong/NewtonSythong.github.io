---
import { getCollection } from "astro:content";

// Derived from the tech-stack tags already on `experience` and `projects`
// entries — no separately hand-maintained skills list. A new tag on either
// collection appears here automatically with no code changes; likewise,
// the `projects` collection is empty until ticket 07 adds fixture entries,
// and this section already degrades gracefully to whatever tags exist.
const experience = await getCollection("experience");
const projects = await getCollection("projects");

const tags = [
	...new Set([
		...experience.flatMap((entry) => entry.data.tags),
		...projects.flatMap((entry) => entry.data.tags),
	]),
].sort((a, b) => a.localeCompare(b));
---

<section id="skills" aria-labelledby="skills-heading">
	<h2 id="skills-heading">Skills</h2>
	{
		tags.length > 0 ? (
			<ul class="tags">
				{tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		) : (
			<p>No skills recorded yet.</p>
		)
	}
</section>

<style>
	/* Every rule this section used to carry — section width and padding, the
	   heading, the pill styling — is now shared from src/styles/global.css.
	   Skills is nothing but a tag cloud, so it only sizes the pills up a
	   little: they are the whole content here, not a footnote to a card. */
	.tags {
		font-size: 0.85rem;
		gap: 0.55rem;
	}

	.tags li {
		padding: 0.3rem 0.8rem;
	}
</style>
