---
// Real contact address and résumé asset (public/resume.pdf, sourced from
// NewtonCV3.pdf) per ticket 10.
const email = "newtsythong@gmail.com";
// The CV's header sends readers here instead of to GitHub directly, on the
// reasoning that one link can stand for all of them. That only holds if this
// page actually carries the onward link — until it did, the trail ended here.
const githubUrl = "https://github.com/NewtonSythong";
const githubHandle = "github.com/NewtonSythong";
---

<section id="contact" aria-labelledby="contact-heading">
	<h2 id="contact-heading">Contact</h2>
	<div class="actions">
		<a class="resume" href="/resume.pdf" download>Download résumé (PDF)</a>
		<a class="email" href={`mailto:${email}`}>{email}</a>
		<a class="github" href={githubUrl} target="_blank" rel="noopener noreferrer">
			{githubHandle}
		</a>
	</div>
</section>

<style>
	/* Section furniture comes from src/styles/global.css; link colour is now
	   the document default, so only the calls to action are styled here.
	   Contact is the last thing on the page and the point of the whole site,
	   so the résumé download is given a filled button and the two ways of
	   reaching Newton sit beside it as quieter monospace links. */
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.resume {
		padding: 0.55rem 1.2rem;
		border: 1px solid var(--color-accent);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-decoration: none;
		background-color: hsl(var(--accent-hsl) / 0.1);
		transition:
			background-color 0.25s var(--ease),
			box-shadow 0.25s var(--ease),
			transform 0.25s var(--ease);
	}

	.resume:hover,
	.resume:focus-visible {
		background-color: hsl(var(--accent-hsl) / 0.2);
		box-shadow: 0 8px 22px -12px hsl(var(--accent-hsl) / 0.9);
		transform: translateY(-2px);
	}

	.email,
	.github {
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	/* The handle is shown in full rather than as the word "GitHub", so the
	   destination is legible before it is clicked and readable if the page is
	   printed. It carries the same leaning arrow the Projects cards give
	   their outbound links; the email does not, because a mailto opens a
	   compose window rather than going anywhere. */
	.github {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
	}

	.github::after {
		content: "→";
		transition: transform 0.25s var(--ease);
	}

	.github:hover::after,
	.github:focus-visible::after {
		transform: translateX(3px);
	}
</style>
